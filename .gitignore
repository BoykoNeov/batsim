# Rust build output
/target

# The wasm bundle is a build artifact, not source: `wasm-pack build crates/sim-wasm
# --target web --out-dir ../../web/pkg` regenerates it, and the README says so.
# (wasm-pack also drops its own `pkg/.gitignore`; this entry is here so the rule is
# visible in the repo's own file rather than only in generated output.)
/web/pkg

# What examples/experiment.mjs writes, when it is run from the workspace root (which
# is what the README tells people to do). Results, not source.
/experiment.csv
/experiment-snapshot.json

# Backup / editor files
**/*.rs.bk
*.pdb

# Local scratch (repo tree must never hold temp artifacts — see CLAUDE.md)
/scratch

# Python bytecode from the tools/reference golden pipeline (dev-only, not shipped)
__pycache__/
*.pyc

# Per-user Claude Code settings (keep local; shared config can be committed later)
.claude/settings.local.json

# Godot editor/import cache for the demo project. Regenerated by
# `godot --headless --path godot --import`; see docs/plans/phase-5-godot.md.
# The `.gdextension` file IS source and is committed; what it points at lives in
# /target, which is already ignored above.
/godot/.godot
